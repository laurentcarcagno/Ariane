# Site configuration of an ARIANE deployment on the INFRA platform. deploy.sh copies it to deploy/.env (git-ignored).

# --- Public addresses
ARIANE_URL=https://ariane.karka.lan
KEYCLOAK_URL=https://keycloak.karka.lan
KEYCLOAK_REALM=infra
# Users of the realm that get a customer (attribute "customer" -> claim "customer"), as USER=customer pairs
ARIANE_CUSTOMER_USERS="laurent.carcagno=beyond-gravity"

# --- Reachability from the containers
INFRA_NETWORK=infra_default
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
OPENBAO_ADDR=http://openbao:8200

# --- How to administer the existing Keycloak / OpenBao / proxy containers
PODMAN="sudo podman"
KEYCLOAK_CONTAINER=keycloak
KEYCLOAK_ADMIN_USER=admin
# KEYCLOAK_ADMIN_PASSWORD=          # else INFRA_DIR/.env ADMIN_PASSWORD
OPENBAO_CONTAINER=openbao
# OPENBAO_ROOT_TOKEN=               # else INFRA_DIR/secrets/openbao-init.json
PROXY_CONTAINER=proxy
INFRA_DIR=/home/laurent/INFRA

# --- Generated by deploy.sh (never commit)
ARIANE_DB_PASSWORD=
OPENBAO_ROLE_ID=
OPENBAO_SECRET_ID=
