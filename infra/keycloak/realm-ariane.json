{
  "realm": "ariane",
  "enabled": true,
  "displayName": "ARIANE",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 600,
  "roles": {
    "realm": [
      { "name": "user", "description": "Can import and read harnesses of their own customer" },
      { "name": "admin", "description": "Administrates users of their customer" }
    ]
  },
  "defaultRoles": ["user"],
  "clients": [
    {
      "clientId": "ariane-web",
      "name": "ARIANE web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["https://localhost/*"],
      "webOrigins": ["https://localhost"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://localhost/*"
      },
      "defaultClientScopes": ["basic", "acr", "web-origins", "profile", "roles", "email"],
      "protocolMappers": [
        {
          "name": "audience-ariane-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "ariane-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "customer",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "customer",
            "claim.name": "customer",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}},{\"name\":\"customer\",\"displayName\":\"Customer\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\"]}}]}"
          ]
        }
      }
    ]
  },
  "users": [
    {
      "username": "alice.bg",
      "email": "alice.bg@example.test",
      "firstName": "Alice",
      "lastName": "BG",
      "enabled": true,
      "emailVerified": true,
      "attributes": { "customer": ["beyond-gravity"] },
      "realmRoles": ["user"],
      "credentials": [{ "type": "password", "value": "dev-only-change-me", "temporary": true }]
    }
  ]
}
